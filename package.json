{
  "name": "noteit",
  "productName": "NoteIt",
  "version": "1.1.0",
  "description": "Floating post-its always on screen",
  "author": "Pedro Sotelo",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.peltre.noteit",
    "productName": "NoteIt",
    "files": [
      "main.js",
      "preload.js",
      "canvas.html",
      "canvas.js",
      "styles.css",
      "assets/**"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peltre/NoteIt.git"
  },
  "keywords": ["sticky-notes", "post-it", "electron", "always-on-top", "productivity"],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Peltre/NoteIt/issues"
  },
  "homepage": "https://github.com/Peltre/NoteIt#readme",
  "devDependencies": {
    "electron": "^44.4.5"
  }
}